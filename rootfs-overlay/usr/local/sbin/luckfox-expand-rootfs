#!/usr/bin/env bash
set -euo pipefail

MARKER_DIR="/var/lib/luckfox"
MARKER_FILE="${MARKER_DIR}/rootfs-expanded"

log() {
    printf 'luckfox-expand-rootfs: %s\n' "$*"
}

fail() {
    log "ERROR: $*"
    exit 1
}

if [[ "$(id -u)" -ne 0 ]]; then
    fail "This script must run as root."
fi

if [[ -e "${MARKER_FILE}" ]]; then
    log "Root filesystem has already been expanded."
    exit 0
fi

ROOT_SOURCE="$(
    findmnt -n -o SOURCE / 2>/dev/null \
        || true
)"

ROOT_FSTYPE="$(
    findmnt -n -o FSTYPE / 2>/dev/null \
        || true
)"

if [[ -z "${ROOT_SOURCE}" ]]; then
    fail "Could not determine the root filesystem device."
fi

if [[ "${ROOT_SOURCE}" == /dev/* ]]; then
    ROOT_DEVICE="$(
        readlink -f "${ROOT_SOURCE}" 2>/dev/null \
            || printf '%s' "${ROOT_SOURCE}"
    )"
else
    fail "Unexpected root filesystem source: ${ROOT_SOURCE}"
fi

if [[ ! -b "${ROOT_DEVICE}" ]]; then
    fail "Root filesystem source is not a block device: ${ROOT_DEVICE}"
fi

if [[ "${ROOT_FSTYPE}" != "ext4" ]]; then
    fail "Unsupported root filesystem type: ${ROOT_FSTYPE}"
fi

if ! command -v resize2fs >/dev/null 2>&1; then
    fail "resize2fs is not installed."
fi

BEFORE_SIZE="$(
    df -B1 --output=size / 2>/dev/null \
        | awk 'NR == 2 {print $1}'
)"

log "Root source: ${ROOT_SOURCE}"
log "Root device: ${ROOT_DEVICE}"
log "Filesystem: ${ROOT_FSTYPE}"
log "Expanding filesystem to the full partition size..."

resize2fs "${ROOT_DEVICE}"

AFTER_SIZE="$(
    df -B1 --output=size / 2>/dev/null \
        | awk 'NR == 2 {print $1}'
)"

mkdir -p "${MARKER_DIR}"

cat > "${MARKER_FILE}" <<EOF
Root source: ${ROOT_SOURCE}
Root device: ${ROOT_DEVICE}
Filesystem: ${ROOT_FSTYPE}
Size before: ${BEFORE_SIZE:-unknown}
Size after: ${AFTER_SIZE:-unknown}
Completed: $(date --iso-8601=seconds)
EOF

chmod 0644 "${MARKER_FILE}"

log "Root filesystem expansion completed."
log "Size before: ${BEFORE_SIZE:-unknown} bytes"
log "Size after: ${AFTER_SIZE:-unknown} bytes"
